Pipfile.lock
**/zip/**

# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# Exclude everything in the sql folder except the .gitkeep and .sql files that start with select_, table_, view_ within sql folder
sql/*
!sql/.gitkeep
!sql/**/select_*.sql
!sql/**/table_*.sql
!sql/**/view_*.sql

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs #
########
.idea
**.pyc
**.idea/**

# Tests #
#########
.nox
.pytest_cache
.coverage
**.env
*.egg-info/
*.egg
.eggs/
eggs/

# TerraForm #
#############
.terraform
terraform.tfstate
terraform.tfstate.backup

# Shapefiles #
##############
**.shp
**.shx

# Folders #
###########
data/*
!data/.gitkeep
dashboards/*
!dashboards/.gitkeep
